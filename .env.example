# EmailJS Configuration
# Pour obtenir ces identifiants, créez un compte sur https://www.emailjs.com/

# Service ID de votre service EmailJS
VITE_EMAILJS_SERVICE_ID=your_service_id

# Template ID de votre template d'email
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Public Key (API Key) de votre compte EmailJS
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Supabase (URL du projet et clé anon/publishable uniquement côté navigateur)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
